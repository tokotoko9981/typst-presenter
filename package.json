{
  "name": "typst-presenter",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "repository": "https://github.com/tokotoko9981/typst-presenter.git",
  "type": "module",
  "scripts": {
    "copy:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons:generate": "node scripts/generate-icons.mjs",
    "tauri:dev": "npx --yes @tauri-apps/cli@2 dev",
    "tauri:build": "npx --yes @tauri-apps/cli@2 build"
  },
  "dependencies": {
    "lucide-react": "^1.74.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
